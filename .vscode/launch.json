{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Simulator",               // 配置名称
            "type": "cppdbg",                        // C++ GDB 调试
            "request": "launch",                     // 启动模式
            "program": "${workspaceFolder}/build/simulator", // 可执行文件路径
            "args": [
                "-i",
                "test/build/without-syscall/add.riscv",
                "-v"
            ],
            "stopAtEntry": false,                    // 是否在 main 停
            "cwd": "${workspaceFolder}",             // 工作目录
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
